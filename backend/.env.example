PORT=5000
MONGO_URI=mongodb://localhost:27017/school-management
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d
NODE_ENV=development
# Comma-separated list of allowed frontend origins (production: set to your Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173
# Frontend URL used in password-reset email links
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — use a Gmail App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Optional global pricing promo — an extra discount applied on top of each
# plan's sale price. Fraction between 0 and 0.9 (e.g. 0.10 = 10% off).
# Empty or 0 = no promo (per-plan list/sale prices still apply).
PRICING_PROMO_PCT=0
